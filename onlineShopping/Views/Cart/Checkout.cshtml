@{
}
<div class="container my-5">
    <h2 class="logo text-center mb-5">Checkout</h2>
    <div class="row g-5">
        <div class="col-md-7">
            <h5 class="mb-4 text-uppercase small fw-bold">Shipping Address</h5>
            <form asp-controller="Order" asp-action="PlaceOrder" method="post">
                <div class="mb-3">
                    <label class="small">Full Name</label>
                    <input name="FullName" class="form-control rounded-0" required />
                </div>
                <div class="mb-3">
                    <label class="small">Detailed Address</label>
                    <textarea name="ShippingAddress" class="form-control rounded-0" rows="3" required></textarea>
                </div>
                <button type="submit" class="btn btn-dark w-100 rounded-0 py-3 mt-4">PLACE ORDER</button>
            </form>
        </div>
        <div class="col-md-5">
            <div class="bg-light p-4">
                <h5 class="small text-uppercase fw-bold mb-3">Order Items</h5>
                <!-- Loop through items to show simple summary -->
            </div>
        </div>
    </div>
</div>