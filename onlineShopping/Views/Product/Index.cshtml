@{
}
@model IEnumerable<onlineShopping.Models.Product>
<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="logo">Products</h2>
        <a asp-action="Create" class="btn btn-dark btn-sm rounded-0">ADD NEW</a>
    </div>
    <table class="table align-middle border">
        <thead class="bg-light small text-uppercase">
            <tr>
                <th>Image</th>
                <th>Name</th>
                <th>Category</th>
                <th>Price</th>
                <th>Stock</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><img src="@item.ImageUrl" width="50" class="bg-light"></td>
                    <td>@item.Name</td>
                    <td>@item.Category.Name</td>
                    <td>$@item.Price</td>
                    <td>@item.StockQuantity</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info rounded-0">View</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark rounded-0">Edit</a>
                        <!-- NEW DELETE FORM -->
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;" onsubmit="return confirmDelete('@item.Name')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-0">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@section Scripts {
    <script>
        function confirmDelete(productName) {
            return confirm("Are you sure you want to delete '" + productName + "'? This action cannot be undone.");
        }
    </script>
}