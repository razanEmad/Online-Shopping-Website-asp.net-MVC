<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Buver - Fashion Store</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Poppins:wght@300;400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Top Promo Bar -->
    <div class="promo-bar text-center py-2">
        FREE DELIVERY AND RETURNS FROM $150 • 10% OFF ON ALL CLOTHING
    </div>

    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top">
            <div class="container">
                <a class="navbar-brand logo" asp-area="" asp-controller="Home" asp-action="Index">Buver</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-center">
                    <ul class="navbar-nav flex-grow-1 justify-content-center">
                        <li class="nav-item"><a class="nav-link"  asp-controller="Product" asp-action="Shop">SHOP</a></li>
                        <li class="nav-item"><a class="nav-link" href="#">NEW ARRIVALS</a></li>
                        <li class="nav-item"><a class="nav-link" href="#">JOURNAL</a></li>
                        <li class="nav-item"><a class="nav-link" href="#">STYLES</a></li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-danger fw-bold" asp-controller="Admin" asp-action="Dashboard">
                                    <i class="fa-solid fa-screwdriver-wrench"></i> Admin Panel
                                </a>
                            </li>
                        }
                    </ul>
                    <div class="nav-icons d-flex">
                        <a href="#"><i class="fa-solid fa-magnifying-glass"></i></a>
                        <a href="#"><i class="fa-regular fa-heart"></i></a>
                        @await Html.PartialAsync("_LoginPartial")
                        <a asp-controller="Cart" asp-action="Index" class="position-relative">
                            <i class="fa-solid fa-bag-shopping"></i>
                            <span class="badge rounded-pill bg-danger cart-count">
                                @await Component.InvokeAsync("CartCount")
                            </span>
                        </a>
                        <a asp-controller="Account" asp-action="Profile" class="ms-3"><i class="fa-regular fa-user"></i></a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="footer border-top text-muted py-5">
        <div class="container text-center">
            <h2 class="logo mb-4">Buver</h2>
            <p>&copy; 2024 - Buver Fashion. All Rights Reserved.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>