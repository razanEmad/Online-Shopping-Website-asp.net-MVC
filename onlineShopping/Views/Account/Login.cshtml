@{
}
<div class="container my-5 py-5">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <h2 class="logo text-center mb-4">Login</h2>
            <form asp-action="Login" method="post" id="loginForm" novalidate>
                <div class="form-floating mb-3">
                    <input name="Email" id="loginEmail" type="email" class="form-control rounded-0" placeholder="name@example.com" required />
                    <label>Email address</label>
                    <div class="invalid-feedback">Please enter a valid email address.</div>
                </div>
                <div class="form-floating mb-3">
                    <input name="Password" id="loginPassword" type="password" class="form-control rounded-0" placeholder="Password" required />
                    <label>Password</label>
                    <div class="invalid-feedback">Password is required.</div>
                </div>
                <button type="submit" class="btn btn-dark w-100 rounded-0 py-3">SIGN IN</button>
            </form>
            <p class="mt-3 text-center small">New customer? <a asp-action="Register" class="text-dark">Create account</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('loginForm').addEventListener('submit', function (event) {
            const form = event.currentTarget;
            const email = document.getElementById('loginEmail').value;
            

            if (!form.checkValidity() || !email.includes('@@') ) {
                event.preventDefault();
                event.stopPropagation();
            }

            form.classList.add('was-validated');
        }, false);
    </script>

}